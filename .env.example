# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Google AI Studio key (Step 01). The google-genai SDK reads this name automatically.
GEMINI_API_KEY=

# Bearer token the API accepts (Step 07). Any long random string for local use.
SHOPPER_API_TOKEN=

# Shared secret used to sign outbound webhooks with HMAC-SHA256 (Step 07).
SHOPPER_WEBHOOK_SECRET=
